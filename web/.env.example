# Copia a .env.local. Valores en Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp · Embedded Signup (vacías hasta que Meta apruebe a Teo como Tech Provider)
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_ES_CONFIG_ID=
# Solo servidor (Vercel): App Secret de la app de Meta, para intercambiar el code del Embedded Signup
META_APP_SECRET=
