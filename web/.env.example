# Copia a .env.local. Valores en Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# El resto de la configuración (Meta/WhatsApp, Google Places, IA, registro) se administra desde el
# panel superadmin (/admin) y vive en la base de datos y en Vault. Next no necesita esas claves.
